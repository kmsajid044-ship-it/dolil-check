# Optional overrides. The application does not load this file automatically;
# export chosen values in your shell or deployment platform.

# Runtime database, private office keys and generated demo files.
DOLIL_DATA=/absolute/path/to/dolil-check/data/runtime

# Public base URL embedded in newly generated QR links.
DOLIL_PUBLIC_URL=http://127.0.0.1:8000

# Required to make demo writes. Keep both values private and replace the placeholders.
DOLIL_ADMIN_PASSWORD=replace-with-a-strong-demo-only-password
DOLIL_SESSION_SECRET=replace-with-a-random-session-signing-secret

# Test/import switch only. Leave unset for normal use.
# DOLIL_NO_APP=1
